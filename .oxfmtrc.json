{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/server.bundle.mjs",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/*.md",
    "**/*.py",
    "**/.serena/**"
  ]
}
